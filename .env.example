# AgroVista AI Application Environment Configuration Template
# Copy this file to .env for local overrides (never commit secrets or production credentials)

# Flask Server Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Application Settings
SECRET_KEY=agrovista-local-dev-key-change-in-production
APP_NAME=AgroVista AI
LOG_LEVEL=INFO
